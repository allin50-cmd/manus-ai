{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "outDir": "dist/server",
    "target": "ES2020"
  },
  "include": ["server", "shared"],
  "exclude": ["node_modules", "dist", "client"]
}
